{
  "name": "social-publisher-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Production-oriented Social Publisher API and workers",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:api": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "start:dev": "nest start --watch",
    "start:worker:dev": "nest start --watch --entryFile worker",
    "lint": "eslint \"{src,test,prisma,scripts}/**/*.ts\"",
    "lint:fix": "pnpm lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --runInBand",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "openapi:export": "ts-node scripts/export-openapi.ts",
    "cli": "ts-node src/cli.ts",
    "browser:login": "ts-node src/cli.ts browser:login",
    "browser:install": "playwright install chromium",
    "social:auth-smoke": "tsx scripts/social-auth-smoke.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.913.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.2.1",
    "@prisma/client": "^6.17.1",
    "amqplib": "^0.10.9",
    "bcryptjs": "^3.0.2",
    "cheerio": "1.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "fast-xml-parser": "^5.3.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.1",
    "openai": "^6.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "playwright": "1.64.0",
    "prisma": "^6.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "2.18.0",
    "tsx": "^4.20.6",
    "undici": "^7.16.0",
    "zod": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "htmlparser2": "10.0.0",
      "@prisma/config>deepmerge-ts": "8.0.0",
      "@nestjs/swagger>js-yaml": "5.4.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/amqplib": "^0.10.7",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.13",
    "@types/node": "^24.7.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/sanitize-html": "^2.16.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1"
  }
}
