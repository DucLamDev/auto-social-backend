# Runtime
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
TRUST_PROXY=false
LOG_LEVEL=info

# Compose-only service credentials (replace every value in production)
POSTGRES_DB=social_publisher
POSTGRES_USER=social_publisher
POSTGRES_PASSWORD=change_me
REDIS_PASSWORD=change_me
RABBITMQ_USER=social_publisher
RABBITMQ_PASSWORD=change_me
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me
BACKEND_IMAGE=social-publisher-backend:latest
# Optional local host ports. Change these when another project already uses the defaults.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
RABBITMQ_AMQP_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# PostgreSQL / Prisma
DATABASE_URL=postgresql://social_publisher:change_me@localhost:5432/social_publisher?schema=public

# Infrastructure
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://social_publisher:change_me@localhost:5672
RABBITMQ_EXCHANGE=social.publisher
RABBITMQ_PREFETCH=1

# Authentication (use >= 32 random bytes in production)
JWT_ACCESS_SECRET=a8f3c9e2b1d4f7a0c3e6b9d2f5a8c1e4b7d0f3a6c9e2b5d8f1a4c7e0b3d6f9a2
JWT_REFRESH_SECRET=f4b7d0f3a6c9e2b5d8f1a4c7e0b3d6f9a2c5e8b1d4f7a0c3e6b9d2f5a8c1e4b7
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# base64 encoded 32-byte key: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY_VERSION=v1

# AI
AI_DEFAULT_PROVIDER=gemini
AI_TIMEOUT_MS=60000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Backward-compatible fallback when AI_TIMEOUT_MS is omitted.
OPENAI_TIMEOUT_MS=60000

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# VPSTTT AI = "AI API" of the company IDE (OpenAI-compatible, Claude/Codex accounts).
# Base URL is shown in the IDE AI API panel, e.g. https://<ide-host>/ai-api/v1.
# The key must allow this server's public IP and the "content" scope.
VPSTTT_AI_BASE_URL=
VPSTTT_AI_API_KEY=
# claude:haiku (fast) | claude:sonnet | claude:opus | gpt:
VPSTTT_AI_MODEL=claude:sonnet
# Each request runs a full AI session; keep these within the key's limits.
VPSTTT_AI_TIMEOUT_MS=180000
VPSTTT_AI_MAX_CONCURRENCY=2
VPSTTT_AI_RPM=10
# Three AI roles: the writer is the provider chosen per campaign (above); the reviewer
# scores every draft and checks clumsy seeding and risk for the company; the final
# approver reads the finished draft once and only a post it approves can be approved
# or published. Format provider:model (openai | deepseek | gemini | vpsttt; an empty
# model = that provider's *_MODEL). The VPSTTT AI key must be allowed to use the
# chosen models (claude:sonnet, claude:opus) or the calls are refused.
# No key for the reviewer's provider: drafts are reviewed by the writer instead.
# No key for the approver's provider: every approval fails and posts wait for a person.
# (Ba vai AI: viết bài theo chiến dịch, chấm điểm + soát seeding / rủi ro cho công ty,
# duyệt cuối. Key VPSTTT AI phải được phép dùng các model này.)
AI_REVIEWER=vpsttt:claude:sonnet
AI_APPROVER=vpsttt:claude:opus
# false turns the final approver off (drafts are then recommended on the review alone).
AI_APPROVAL_ENABLED=true
# AI images for campaigns (same base URL and key; the key also needs the "image" scope, model vpsttt-image).
# One image per destination whose publishing route can attach it; false turns AI images off.
AI_IMAGE_ENABLED=true
VPSTTT_AI_IMAGE_MODEL=vpsttt-image
# Each image runs a Codex session (about 30 s to 2 min): one at a time by default.
VPSTTT_AI_IMAGE_TIMEOUT_MS=300000
VPSTTT_AI_IMAGE_CONCURRENCY=1
VPSTTT_AI_IMAGE_RPM=6
# Image provider: vpsttt (IDE AI API, Codex image account, above) or openai (GPT Image with
# OPENAI_API_KEY; OpenAI may require organisation verification for GPT Image models).
AI_IMAGE_PROVIDER=vpsttt
OPENAI_IMAGE_MODEL=gpt-image-1
# low | medium | high | auto. High looks best and costs the most per image.
OPENAI_IMAGE_QUALITY=high
OPENAI_IMAGE_TIMEOUT_MS=300000
OPENAI_IMAGE_CONCURRENCY=2
OPENAI_IMAGE_RPM=10

# MCP endpoint (POST /mcp) for AI agents such as Codex. Off by default.
# Create a token inside the API container: pnpm mcp:token create --email <admin email> --name codex
MCP_ENABLED=false
# true lets an agent approve campaigns, i.e. really publish. Keep false unless needed.
MCP_ALLOW_PUBLISH=false
MCP_RATE_LIMIT_PER_MINUTE=60

# Chrome extension: when a composer field is not found (site redesign), ask the AI
# which visible element to use. Unapproved picks only pre-fill; approve them on the
# web or via MCP to allow automatic submit. Off by default.
EXTENSION_UI_RECOVERY_ENABLED=false
# Empty = AI_DEFAULT_PROVIDER. claude:haiku via vpsttt is a good fast choice.
EXTENSION_UI_HINT_PROVIDER=
EXTENSION_UI_HINT_MIN_CONFIDENCE=0.6
# Chrome extension: when a post form has extra controls (language, Lemmy / Discuit
# community, NSFW, flair…), ask the AI which values fit the post; never the title, body,
# passwords or consent boxes. Uses EXTENSION_UI_HINT_PROVIDER. On by default.
# (Tiện ích hỏi AI chọn ngôn ngữ, community… còn thiếu trên form đăng bài.)
EXTENSION_AI_FORM_FILL_ENABLED=true

# Object storage (MinIO locally, S3 in production)
S3_ENDPOINT=http://localhost:9000
# Browser/social-network reachable HTTPS origin for objects (never an internal Docker hostname)
S3_PUBLIC_URL=http://localhost:9000/social-publisher
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change_me
S3_BUCKET=social-publisher
S3_FORCE_PATH_STYLE=true

# OAuth application configuration (only configure providers you enable)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Required by LinkedIn Posts API; choose a currently supported YYYYMM version from official docs
LINKEDIN_API_VERSION=
X_CLIENT_ID=
X_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:3001/api/v1/oauth

# Local Playwright worker. Keep prefetch at 1 so Chromium jobs cannot exhaust
# this development machine. Production needs a dedicated isolated worker.
BROWSER_AUTOMATION_ENABLED=true
BROWSER_AUTOMATION_HEADLESS=true
BROWSER_AUTOMATION_TIMEOUT_MS=90000

# Bootstrap seed (change immediately; only used by prisma seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!Change
