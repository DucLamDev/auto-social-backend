# Runtime
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
TRUST_PROXY=false
LOG_LEVEL=info

# Compose-only service credentials (replace every value in production)
POSTGRES_DB=social_publisher
POSTGRES_USER=social_publisher
POSTGRES_PASSWORD=change_me
REDIS_PASSWORD=change_me
RABBITMQ_USER=social_publisher
RABBITMQ_PASSWORD=change_me
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me
BACKEND_IMAGE=social-publisher-backend:latest
# Optional local host ports. Change these when another project already uses the defaults.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
RABBITMQ_AMQP_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# PostgreSQL / Prisma
DATABASE_URL=postgresql://social_publisher:change_me@localhost:5432/social_publisher?schema=public

# Infrastructure
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://social_publisher:change_me@localhost:5672
RABBITMQ_EXCHANGE=social.publisher
RABBITMQ_PREFETCH=10

# Authentication (use >= 32 random bytes in production)
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-at-least-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# base64 encoded 32-byte key: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY_VERSION=v1

# AI
AI_DEFAULT_PROVIDER=openai
AI_TIMEOUT_MS=60000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Backward-compatible fallback when AI_TIMEOUT_MS is omitted.
OPENAI_TIMEOUT_MS=60000

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Object storage (MinIO locally, S3 in production)
S3_ENDPOINT=http://localhost:9000
# Browser/social-network reachable HTTPS origin for objects (never an internal Docker hostname)
S3_PUBLIC_URL=http://localhost:9000/social-publisher
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change_me
S3_BUCKET=social-publisher
S3_FORCE_PATH_STYLE=true

# OAuth application configuration (only configure providers you enable)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Required by LinkedIn Posts API; choose a currently supported YYYYMM version from official docs
LINKEDIN_API_VERSION=
X_CLIENT_ID=
X_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:3001/api/v1/oauth

# Browser-assisted publishing. Login is captured interactively with
# `pnpm browser:login <platform-account-uuid>`; no account password is stored.
# Each active browser job launches Chromium and may occupy a worker for up to
# BROWSER_AUTOMATION_TIMEOUT_MS. Size RABBITMQ_PREFETCH/workers for available
# CPU and memory; a dedicated browser-worker queue is recommended at scale.
BROWSER_AUTOMATION_ENABLED=false
BROWSER_AUTOMATION_HEADLESS=true
BROWSER_AUTOMATION_TIMEOUT_MS=90000
# Optional when Chromium is installed outside Playwright's default location.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

# Bootstrap seed (change immediately; only used by prisma seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!Change
